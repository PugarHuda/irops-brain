{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/static/:path*", "destination": "/:path*" },
